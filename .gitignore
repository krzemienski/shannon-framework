# Shannon runtime logs (created at runtime by lib/hook-runner.js).
logs/shannon/*.jsonl
logs/shannon/*.json
logs/shannon/*.txt
!logs/shannon/.gitkeep

# Backup files from setup.sh / uninstall-others.sh.
*.bak
*.pre-shannon-*
*.pre-uninstall-*

# Node / OS noise.
node_modules/
.DS_Store

# Mimirs sidecars (auto-generated by another tool).
.mimirs/

# Old V1 artifacts (not curated here — out of scope for task #6).
__pycache__/
